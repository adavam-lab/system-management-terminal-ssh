{
  "name": "ssh-manager",
  "version": "1.0.3",
  "description": "Aplicación para administrar conexiones SSH",
  "author": {
    "name": "MadXcorp - ADAVAM",
    "url": "https://www.adavam.com"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adavam-lab/system-management-terminal-ssh.git"
  },
  "homepage": "https://www.adavam.com",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"ng serve --port 4050\" \"wait-on http://localhost:4050 && electron .\"",
    "build": "ng build",
    "electron:build": "ng build && electron-builder",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "build": {
    "appId": "com.ssh-manager.app",
    "productName": "XSS Manager",
    "copyright": "Copyright © 2026 MadXcorp - ADAVAM. Licencia AGPL-3.0-or-later",
    "npmRebuild": false,
    "icon": "public/logo-single.png",
    "mac": {
      "icon": "public/logo-single.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "icon": "public/logo-single.png",
      "title": "${productName} ${version}"
    },
    "win": {
      "icon": "public/logo-single.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "ADAVAM",
      "shortcutName": "XSS Manager",
      "license": "build/license.txt",
      "include": "build/installer.nsh",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "uninstallDisplayName": "${productName} ${version}"
    },
    "files": [
      "**/*",
      "dist/ssh-manager/**/*",
      "!rustdesk-server/**/*"
    ]
  },
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@novnc/novnc": "^1.7.0",
    "@types/better-sqlite3": "^9.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "node-pty": "^1.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.4.1",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0"
  }
}